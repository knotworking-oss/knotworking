{
  "name": "@knotworking/mcp",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Model Context Protocol server for Knotworking: lets agents read and write tasks, projects, documents and comments through the public API.",
  "bin": {
    "knotworking-mcp": "./dist/stdio.js"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/http.ts",
    "dev:stdio": "tsx --env-file-if-exists=../../.env src/stdio.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../../.env dist/http.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@knotworking/api-client": "workspace:*",
    "@knotworking/core": "workspace:*",
    "@modelcontextprotocol/server": "^2.4.0",
    "hono": "^4.13.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^24.0.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
