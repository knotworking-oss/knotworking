{
  "name": "knotworking",
  "private": true,
  "description": "Knotworking — tasks, projects and a team wiki in one workspace.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "node --test scripts/dependency-security.test.mjs && turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @knotworking/db generate",
    "db:migrate": "pnpm --filter @knotworking/db migrate",
    "db:seed": "pnpm --filter @knotworking/db seed",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "db:reset": "pnpm --filter @knotworking/db reset && pnpm db:setup",
    "desktop": "pnpm --filter @knotworking/desktop desktop:dev",
    "ui:add": "cd apps/web && pnpm dlx shadcn@latest add"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3"
  }
}
