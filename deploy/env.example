# Knotworking self-hosting configuration (used by compose.yaml).
# Copy to deploy/.env and edit. Never commit deploy/.env, and back it up (docs/self-hosting.md).

# The address your team types into the browser. Examples:
#   http://192.168.1.20:3000      (local server, by IP)
#   http://knotworking.lan:3000      (local server, by hostname)
#   https://knotworking.example.com  (with DOMAIN set below)
APP_URL=http://localhost:3000

# Required, at least 32 characters (the API refuses to start in production with less).
# Generate with: openssl rand -base64 32
# It also encrypts stored calendar/OAuth tokens: keep a copy, because losing or
# changing it signs everyone out and breaks calendar connections.
BETTER_AUTH_SECRET=

# Port Caddy serves plain HTTP on. Use 80 when DOMAIN is set (needed for HTTPS certificates).
HTTP_PORT=3000

# Host port for HTTPS (only published when compose.https.yaml is loaded, see DOMAIN below).
# Let's Encrypt needs 443 to be reachable from the internet, so leave it at 443 unless
# another proxy forwards to this port.
# HTTPS_PORT=443

# Required: password for the bundled Postgres container, no default.
# Generate with: openssl rand -hex 24
# Use letters and digits only (hex is ideal): it is embedded in the database URL
# as-is, so characters like / + = @ : # break the connection.
POSTGRES_PASSWORD=

# Use a hosted database instead of the bundled one (e.g. Neon free tier). Use the pooled
# connection string here and drop channel_binding=require if the string has it. For
# Supabase use the pooler string, not the direct host (see docs/database.md).
# POSTGRES_PASSWORD is still required, but the bundled db container is then unused.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Direct (non-pooled) connection string, used only to apply migrations. Recommended with
# Neon/Supabase poolers. Falls back to DATABASE_URL when unset.
# MIGRATE_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require

# Connections per API process (default 10). Keep it low on free hosted tiers.
# DATABASE_POOL_SIZE=10

# Force prepared statements off (true) or on (false). Auto-detected for Neon/Supabase poolers.
# DATABASE_POOLED=true

# Fixed first-run setup code instead of a random one printed in the API log.
# Leave the line out (or commented) to get a random code; don't set it to an empty value.
# SETUP_TOKEN=

# Loads the public demo workspace (a known owner password) into a non-local database.
# Never set this on a real deployment: hosted databases start empty and the first-run
# setup screen creates your owner account.
# ALLOW_DEMO_SEED=1

# Automatic HTTPS: your domain (DNS must point here; ports 80 and 443 reachable).
# Also set HTTP_PORT=80 above, APP_URL=https://..., and load the HTTPS add-on file,
# which is what publishes port 443:
# DOMAIN=knotworking.example.com
# COMPOSE_FILE=compose.yaml:compose.https.yaml

# Other hostnames/IPs people use to reach the same server (comma-separated).
# TRUSTED_ORIGINS=http://192.168.1.20:3000

# Optional email (invites + password resets). Without it, admins copy links from Settings → Members.
#   smtps://…:465   implicit TLS
#   smtp://…:587    STARTTLS (upgrades to TLS if the server offers it)
# URL-encode special characters in USER and PASSWORD (@ becomes %40).
# MAIL_FROM must be an address your SMTP provider accepts (usually a verified sender
# or a domain you own). If it is unset or empty, the placeholder
# "Knotworking <no-reply@localhost>" is used, which most providers reject.
# SMTP_URL=smtps://USER:PASSWORD@smtp.example.com:465
# MAIL_FROM=Knotworking <knotworking@example.com>

# Optional "Sign in with Google/GitHub" — only works for invited email addresses.
# Google credentials also enable Google Calendar sync (docs/calendar.md).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Optional Microsoft sign-in + Outlook calendar sync. Google credentials above also
# enable Google Calendar sync. Calendar sync needs an https APP_URL — see docs/calendar.md.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common
# CALENDAR_SYNC_INTERVAL_SECONDS=300

# Per-token request limits in the API (personal API tokens only, not sign-in sessions): reads and
# writes per minute, 0 = off. In memory per API process (a restart resets them).
# API_TOKEN_READ_LIMIT_PER_MINUTE=600
# API_TOKEN_WRITE_LIMIT_PER_MINUTE=120

# Attachments (images in docs, files on tasks). By default they are stored in the `uploads`
# Docker volume (/app/data/uploads in the api container): back it up with the database
# (docs/self-hosting.md). Largest single upload in bytes (default 10 MB, at most 1 GiB):
# UPLOAD_MAX_BYTES=10485760
# Or store them in an S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2, MinIO…) instead
# of the volume. Keep the bucket private; downloads always go through the API's access checks.
# UPLOAD_STORAGE=s3
# S3_BUCKET=knotworking-uploads
# S3_REGION=us-east-1
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# S3_PREFIX=knotworking/

# Optional AI-agent access (docs/mcp.md): the MCP server runs with the stack and Caddy serves it
# at <APP_URL>/mcp. Agents authenticate with a personal API token (knw_…) that members create
# themselves; nothing is configured here for that. To keep it off the network, delete the
# "@mcp" block from deploy/Caddyfile.
# Hostnames accepted in the Host/Origin headers (comma-separated, no ports). Default: localhost
# plus the hostnames of APP_URL and TRUSTED_ORIGINS, which is right for most setups.
# MCP_ALLOWED_HOSTS=knotworking.example.com
# Modules (docs/modules.md).
# Which modules are switched on in this environment, comma-separated. Unset = all except `calendar`, `accounting`, and `bi` (`all` includes it);
# `none` = the platform alone (sign-in, members, teams). A module's tables always exist; switching
# it off hides its routes, data, pages and MCP tools, and switching it back on restores them.
# Known modules: tasks, docs, time (needs tasks), calendar, assets, maintenance (needs assets), checklists, items, food_items (needs items), recipes (needs items), sops, stock (needs items),
# demand (needs items), production (needs recipes and stock), haccp (needs assets),
# people, training (needs people), attendance (needs people), quality,
# purchasing (needs items), costing (needs recipes, production and purchasing), site (needs assets; food checks also use checklists),
# labels (needs recipes and food_items).
# A list from before Food items left Items that names labels, specifications or npd gets food_items added,
# with a warning at startup: add it to the list.
# Who may use each active module is set per member in the app: Settings → Members → Module access.
# KNOTWORKING_MODULES=tasks,docs,time,calendar,assets,maintenance,checklists,items,food_items,recipes,sops,stock,demand,production,haccp,people,training,attendance,quality,purchasing,costing,site,labels

# Abuse limits (per token, in the MCP server): tool calls per minute (0 = off) and the most
# JSON-RPC messages accepted in one batched request.
# MCP_RATE_LIMIT_PER_MINUTE=120
# MCP_MAX_BATCH=10
# Workspace slug used when an agent's tool call doesn't name one.
# KNOTWORKING_DEFAULT_WORKSPACE=acme
