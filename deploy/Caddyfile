# {$SITE_ADDRESS} is ":80" (plain HTTP, any hostname — LAN) or your DOMAIN (automatic
# HTTPS, via compose.https.yaml).
{$SITE_ADDRESS} {
	# Security headers. No Content-Security-Policy on purpose: Next.js injects inline
	# scripts and styles, so a policy that doesn't break the app needs per-request
	# nonces generated by the app itself, which a static proxy header can't provide.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
		-X-Powered-By
	}

	# HSTS only over HTTPS: browsers ignore it on plain HTTP, and a LAN address must
	# never be pinned to HTTPS.
	@https protocol https
	header @https Strict-Transport-Security "max-age=31536000"

	# File uploads (POST /api/v1/workspaces/*/attachments) are streamed through to the web app and
	# the API, which enforces UPLOAD_MAX_BYTES (default 10 MB). Caddy sets no request-body limit of
	# its own; if you add one (request_body max_size), keep it above UPLOAD_MAX_BYTES plus ~64 KB.
	# Attachment downloads carry their own Content-Disposition, nosniff and sandbox CSP headers.

	# Server-sent events (/api/v1/workspaces/*/events) must stream: no compression, no buffering.
	@sse path /api/v1/workspaces/*/events
	@compressible not path /api/v1/workspaces/*/events
	encode @compressible zstd gzip

	# MCP server for AI agents (docs/mcp.md). Callers authenticate with an API token, which the
	# MCP server forwards to the API; delete this block to keep MCP off the network.
	@mcp path /mcp /mcp/*

	handle @mcp {
		reverse_proxy mcp:4100
	}
	handle @sse {
		reverse_proxy web:3000 {
			flush_interval -1
		}
	}
	handle {
		reverse_proxy web:3000
	}
}
