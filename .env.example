# ── Database ─────────────────────────────────────────────────────────────────
# Leave DATABASE_URL unset for zero-setup local development: an embedded PGlite
# (real Postgres in WASM) database is stored in ./.data/pglite.
#
# Free hosted Postgres for a test project or small team (see docs/database.md).
# Drop channel_binding=require from Neon strings if present.
#   Neon:      DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
#   Supabase:  DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
#              (use the pooler string; the direct db.* host is IPv6-only on the free plan)
# Local Docker (`docker compose -f compose.dev.yaml up -d`):
#   DATABASE_URL=postgres://postgres:postgres@localhost:5432/knotworking
#
# DATABASE_URL=

# Direct (non-pooled) connection string used only by `pnpm db:migrate` and the API's
# startup migration. Falls back to DATABASE_URL when unset.
# MIGRATE_DATABASE_URL=

# Connections per API process (default 10). Keep it low on free hosted tiers.
# DATABASE_POOL_SIZE=10

# Force prepared statements off/on (auto-detected for Neon/Supabase poolers).
# DATABASE_POOLED=true

# Hosted (non-local) databases start empty: the first-run setup screen creates the
# owner. `pnpm db:seed` / `db:setup` refuse to touch a non-local database (it would add
# a public-password owner account) unless you explicitly set this to 1.
# ALLOW_DEMO_SEED=1

# ── Modules (docs/modules.md) ────────────────────────────────────────────────
# Which modules are switched on in this environment, comma-separated. Unset = all except `calendar`, `accounting`, and `bi`, which are optional (`all` includes them);
# `none` = the platform alone (sign-in, members, teams). A module's tables always exist; switching
# it off hides its routes, data, pages and MCP tools, and switching it back on restores them.
# HSE: hse (needs site and training), hse_incidents (needs hse; restricted, person-only incident access).
# Known modules: tasks, docs, time (needs tasks), calendar, items, recipes (needs items), sops, stock (needs items),
# customers, despatch (needs customers and stock), sales (needs customers and items), demand (needs items), production (needs recipes, stock and demand), haccp (needs items and production),
# people, training (needs people), attendance (needs people), quality (needs items and stock),
# purchasing (needs items and stock), costing (needs recipes, production and purchasing), site (needs haccp),
# labels (needs recipes).
# Who may use each active module is set per member in the app: Settings → Members → Module access.
# KNOTWORKING_MODULES=tasks,docs,time,calendar,assets,items,recipes,sops,stock,customers,despatch,demand,production,haccp,people,training,attendance,quality,purchasing,costing,site,labels

# The API binds to loopback by default. Keep port 4000 private behind the web proxy.
# API_HOST=127.0.0.1

# ── Public URL ───────────────────────────────────────────────────────────────
# The address people type into their browser. Used for sign-in cookies and the
# links in invitation / password-reset emails. Examples:
#   http://localhost:3000   http://knotworking.lan:3000   https://knotworking.example.com
APP_URL=http://localhost:3000

# ── Authentication ───────────────────────────────────────────────────────────
# Required in production, at least 32 characters. Generate with: openssl rand -base64 32
# It also encrypts stored calendar/OAuth tokens, so changing it breaks those connections.
BETTER_AUTH_SECRET=

# Optional "Sign in with Google/GitHub" (only for invited email addresses).
# Callback URLs: $APP_URL/api/auth/callback/google  ·  $APP_URL/api/auth/callback/github
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Optional Microsoft sign-in + Outlook/Microsoft 365 calendar sync (see docs/calendar.md).
# Google credentials above also enable Google Calendar sync.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common
# How often connected calendars are checked for changes (seconds, min 60).
# CALENDAR_SYNC_INTERVAL_SECONDS=300

# How often the API looks for training, cleaning, maintenance, audits and other records falling
# due and adds them to people's Inbox (seconds; 0 = off). Safe to run on several API instances.
# NOTIFICATION_SWEEP_INTERVAL_SECONDS=900

# How often queued accounting invoices are sent through installed adapters (seconds; 0 = off). Only
# runs with the accounting module on and an adapter installed. Safe to run on several API instances.
# ACCOUNTING_DISPATCH_INTERVAL_SECONDS=300

# Per-token request limits in the API, for personal API tokens (`knw_…`) only; sign-in sessions are
# not limited. Reads (GET/HEAD/OPTIONS) and writes have separate budgets per minute; 0 = off.
# Counted in memory per API process, so a restart resets them and N replicas allow N times as much.
# API_TOKEN_READ_LIMIT_PER_MINUTE=600
# API_TOKEN_WRITE_LIMIT_PER_MINUTE=120

# ── Attachments (images in docs, files on tasks) ─────────────────────────────
# Stored on local disk by default: <repo>/.data/uploads in development (next to the PGlite
# database). Never served publicly: downloads go through the API with the usual session/token and
# workspace checks. Back this folder up together with the database. A relative UPLOAD_DIR is
# resolved from the API's working directory (apps/server under `pnpm dev`), so prefer an absolute path.
# UPLOAD_DIR=/srv/knotworking/uploads
# Largest single upload in bytes (default 10485760 = 10 MB, at most 1 GiB).
# UPLOAD_MAX_BYTES=10485760
# Optional S3-compatible storage instead of the disk (AWS S3, Cloudflare R2, Backblaze B2, MinIO…).
# Uploads are held in memory up to UPLOAD_MAX_BYTES before they are sent to the bucket. Keep the
# bucket private: the API signs every request with these credentials.
# UPLOAD_STORAGE=s3
# S3_BUCKET=knotworking-uploads
# S3_REGION=us-east-1                  # "auto" for Cloudflare R2
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com   # omit for AWS
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true             # needed by MinIO and some other compatibles
# S3_PREFIX=knotworking/               # optional key prefix inside the bucket

# ── Email (optional) ─────────────────────────────────────────────────────────
# Sends invitations and password resets. Without it, emails are printed to the API
# log and admins copy invite/reset links from Settings → Members.
#   smtps://…:465 = implicit TLS, smtp://…:587 = STARTTLS. URL-encode special characters.
# MAIL_FROM must be an address your SMTP provider accepts; if empty, it defaults to
# "Knotworking <no-reply@localhost>", which most providers reject.
# SMTP_URL=smtps://USER:PASSWORD@smtp.example.com:465
# MAIL_FROM=Knotworking <knotworking@example.com>

# ── API server ───────────────────────────────────────────────────────────────
PORT=4000

# ── MCP server (apps/mcp, docs/mcp.md) ───────────────────────────────────────
# Lets AI agents read and write the workspace. HTTP mode (`pnpm dev` starts it) listens on
# MCP_PORT at /mcp; callers send their own `Authorization: Bearer knw_…` API token.
# (Deliberately not PORT / API_URL, which belong to the API and the web app above.)
# KNOTWORKING_API_URL=http://127.0.0.1:4000
# MCP_PORT=4100
# MCP_HOST=127.0.0.1
# Hostnames accepted in the Host/Origin headers (comma-separated, no ports). Default: localhost
# plus the hostnames of APP_URL and TRUSTED_ORIGINS.
# MCP_ALLOWED_HOSTS=localhost,127.0.0.1
# Where the API server reaches the MCP server, for the in-app assistant's tools (docs/assistant.md).
# Default http://127.0.0.1:MCP_PORT/mcp. Its hostname is always accepted by MCP_ALLOWED_HOSTS.
# MCP_INTERNAL_URL=http://127.0.0.1:4100/mcp
# Abuse limits: tool calls per minute per token (0 = off), and the most JSON-RPC messages in one batch.
# MCP_RATE_LIMIT_PER_MINUTE=120
# MCP_MAX_BATCH=10
# Workspace slug used when a tool call doesn't name one.
# KNOTWORKING_DEFAULT_WORKSPACE=acme
# stdio mode only (`pnpm --filter @knotworking/mcp dev:stdio`): the token to act with.
# KNOTWORKING_API_TOKEN=knw_…

# ── Web ──────────────────────────────────────────────────────────────────────
# Where the web server reaches the API internally (not exposed to browsers)
API_URL=http://127.0.0.1:4000

# Reverse proxies in front of the web app that set X-Forwarded-For (compose: 1, Caddy).
# Used to find the client IP for sign-in rate limits. Defaults to 1 in development.
# TRUSTED_PROXIES=1

# Fixed first-run setup code (otherwise a random one is printed in the API log).
# SETUP_TOKEN=
